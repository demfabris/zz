+    try testing.expect(left.page.memory.ptr != right.page.memory.ptr);
+    source.eraseHistory(null);
+    try testing.expectEqual(@as(u21, 'A'), frozen.pin(.{ .screen = .{} }).?.rowAndCell().cell.codepoint());
+}
