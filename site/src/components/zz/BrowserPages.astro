---
// Web pages for the demo's browser panes — donors only, nothing visible.
//
// Astro scope-stamps a component's markup at build time, template innards
// included, so a page's styles have to live in the same component as its
// markup: chrome built with createElement would silently miss every scoped
// rule. The demo script clones `template[data-page="…"]` into a pane's mount on
// navigation (and once at boot for `[data-boot-page]`).
//
// None of this is zz chrome. Each page is web content inside the browser pane,
// so it brings its own type scale and its own palette, and never touches a
// --zz-* token.

// ── gpui.rs ───────────────────────────────────────────────────────────────
// gpui's hello_world example as the page shows it. Long lines are not wrapped:
// the block clips, same as the capture.
const rust = `use gpui::{
    div, prelude::*, px, rgb, size, App, Application, Bounds, Context, SharedString, Window,
    WindowBounds, WindowOptions,
};

struct HelloWorld {
    text: SharedString,
}

impl Render for HelloWorld {
    fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
        div()
            .flex()
            .flex_col()
            .gap_3()
            .bg(rgb(0x505050))
            .size(px(500.0))
            .justify_center()
            .items_center()
            .shadow_lg()
            .border_1()
            .border_color(rgb(0x0000ff))
            .text_xl()
            .text_color(rgb(0xffffff))
            .child(format!("Hello, {}!", &self.text))
            .child(
                div()
                    .flex()
                    .gap_2()
                    .child(div().size_8().bg(gpui::red()))
                    .child(div().size_8().bg(gpui::green()))
                    .child(div().size_8().bg(gpui::blue()))
                    .child(div().size_8().bg(gpui::yellow()))
                    .child(div().size_8().bg(gpui::black()))
                    .child(div().size_8().bg(gpui::white())),
            )
    }
}

fn main() {
    Application::new().run(|cx: &mut App| {
        let bounds = Bounds::centered(None, size(px(500.), px(500.0)), cx);
        cx.open_window(
            WindowOptions {`;

const KEYWORDS = new Set([
	'use',
	'struct',
	'impl',
	'fn',
	'let',
	'mut',
	'for',
	'in',
	'self',
	'pub',
	'as',
	'move',
]);

type Tok = { v: string; c: string | null };

function highlight(src: string): Tok[][] {
	const rx = /"(?:[^"\\]|\\.)*"|[A-Za-z_][A-Za-z0-9_]*!?|0x[0-9a-fA-F]+|\d+\.?\d*|\s+|./g;
	return src.split('\n').map((line) => {
		const raw = [...line.matchAll(rx)].map((m) => m[0]);
		if (raw.length === 0) return [{ v: ' ', c: null }];
		return raw.map((v, i) => {
			const next = raw[i + 1] ?? '';
			if (v[0] === '"') return { v, c: 'str' };
			if (/^0x|^\d/.test(v)) return { v, c: 'num' };
			if (/^\s|^[^A-Za-z_]/.test(v)) return { v, c: null };
			if (KEYWORDS.has(v)) return { v, c: 'kw' };
			if (v === 'gpui' || /^[A-Z]/.test(v)) return { v, c: 'type' };
			if (v.endsWith('!') || next === '(') return { v, c: 'fnc' };
			return { v, c: null };
		});
	});
}

const codeLines = highlight(rust);

// 30 contributor tiles, greyscale placeholders for the avatar grid.
const avatars = Array.from({ length: 30 }, (_, i) => 26 + ((i * 37) % 46));

// ── ghostty.org ───────────────────────────────────────────────────────────
const ghosttySession = [
	'~ ❯ ghostty +version',
	'Ghostty 1.2.2',
	'',
	'build config',
	'  - Zig       : 0.14.0',
	'  - renderer  : Metal',
	'  - libadwaita: false',
];
---

{/* gpui.rs — the reference capture's page. */}
<template data-page="gpui">
	<div class="page">
		<nav class="page-nav">
			<span class="here">gpui</span>
			<span>examples</span>
			<span>github <i>↗</i></span>
			<span class="page-nav-end">zed <i>↗</i></span>
		</nav>

		<div class="page-grid">
			<div class="page-main">
				<h1>gpui</h1>
				<p class="lede">
					A fast, productive UI framework for Rust from the creators of <u>Zed</u>.
				</p>
				<p class="cta">Get Started →</p>
				<h2>Hello, World 🌍</h2>
				<pre class="code"><code>{codeLines.map((line) => (
					<span class="code-line">{line.map((t) => (t.c ? <span class={`t-${t.c}`}>{t.v}</span> : t.v))}</span>
				))}</code></pre>
			</div>

			<aside class="side">
				<h3>gpui is made possible by</h3>
				<div class="avatars">
					{avatars.map((g) => <span style={`background:rgb(${g},${g},${g})`} />)}
				</div>
				<p class="cta small">How to contribute →</p>
				<h3 class="spaced">Contributing to gpui</h3>
				<p class="side-body">
					gpui is an open source project. We welcome contributions, but for the near future
					gpui is tied to <u>Zed</u>, so contributions will need to be made there and kept in
					sync with it.
				</p>
			</aside>
		</div>
	</div>
</template>

{/* python3 -m http.server serving an index.html — browser defaults, no CSS. */}
<template data-page="plain">
	<div class="plain">
		<h1>hello from desktop</h1>
		<hr />
		<p>Served by python3 -m http.server 8000 over the socks5 tunnel.</p>
	</div>
</template>

{/* ghostty.org */}
<template data-page="ghostty">
	<div class="gt">
		<nav class="gt-nav">
			<span class="gt-mark">ghostty</span>
			<span>docs</span>
			<span>download</span>
			<span class="gt-nav-end">github <i>↗</i></span>
		</nav>

		<h1>Ghostty</h1>
		<p class="gt-lede">
			Ghostty is a fast, feature-rich, and cross-platform terminal emulator that uses
			platform-native UI and GPU acceleration.
		</p>
		<span class="gt-cta">Download 1.2.2</span>

		<div class="gt-term">
			<span class="gt-term-bar" aria-hidden="true"><i /><i /><i /></span>
			<code class="gt-term-body">{ghosttySession.map((row) => <span>{row || ' '}</span>)}</code>
		</div>
	</div>
</template>

{/* github.com/tmux/tmux */}
<template data-page="tmux">
	<div class="gh">
		<div class="gh-head">
			<span class="gh-crumb">tmux / <b>tmux</b></span>
			<span class="gh-badge">Public</span>
			<span class="gh-counts">
				<span class="gh-chip">Star <b>36.1k</b></span>
				<span class="gh-chip">Fork <b>2.2k</b></span>
			</span>
		</div>

		<div class="gh-tabs">
			<span class="gh-tab-on">Code</span>
			<span>Issues</span>
			<span>Pull requests</span>
			<span>Actions</span>
			<span>Wiki</span>
			<span>Security</span>
		</div>

		<div class="gh-grid">
			<div class="gh-main">
				<div class="gh-readme">
					<h2>README</h2>
					<p>
						tmux is a terminal multiplexer: it enables a number of terminals to be created,
						accessed, and controlled from a single screen.
					</p>
					<p>
						tmux may be detached from a screen and continue running in the background, then
						later reattached.
					</p>
					<h3>Installation</h3>
					<p class="gh-mono">$ ./configure &amp;&amp; make</p>
				</div>
			</div>

			<aside class="gh-side">
				<h3>About</h3>
				<p class="gh-about">tmux source code</p>
				<p class="gh-meta">Readme · ISC license · 36.1k stars · 2.2k forks</p>
			</aside>
		</div>
	</div>
</template>

{/* What CEF puts up when the host does not resolve. */}
<template data-page="err">
	<div class="err">
		<div class="err-box">
			<h1>This site can't be reached</h1>
			<p class="err-body"><span data-err-host></span>'s server IP address could not be found.</p>
			<p class="err-code">DNS_PROBE_FINISHED_NXDOMAIN</p>
			<span class="err-btn">Reload</span>
		</div>
	</div>
</template>

