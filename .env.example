# zz environment flags — every variable the binaries and scripts read.
# zz does NOT load .env files itself; export these in your shell, or use
# direnv / `set -a; source .env; set +a`. All are optional.

# ── Daemon & transport ────────────────────────────────────────────────
# Socket/named-pipe path override, honored end to end (daemon listen,
# client attach, auto-spawn, kill-server). Equivalent to global --socket.
# Default: $XDG_RUNTIME_DIR/zz/default.sock (Linux), \\.\pipe\zz-<user>-default (Windows).
#ZZ_SOCKET=/run/user/1000/zz/default.sock

# Terminal color scheme for a manually started daemon: "light" or "dark".
# The GUI sets this automatically when it auto-spawns the daemon.
# Default: dark.
#ZZ_COLOR_SCHEME=dark

# ── Browser (CEF OSR) ─────────────────────────────────────────────────
# Chromium's GPU process is enabled by default so WebGL/canvas/video decode
# are hardware accelerated. Set to 0 to force software rendering/compositing.
#ZZ_BROWSER_GPU=0

# Shared-texture OSR is enabled by default and requires GPU acceleration. If a
# visible Linux browser produces no first frame within two seconds, zz recreates
# only that pane in readback mode. Set to 0 to force readback OSR everywhere.
#ZZ_BROWSER_SHARED_TEXTURE=0

# OSR frame-rate ceiling, 1..=240. Default: 60. Slated for deletion at
# M4 when external begin frames make the display refresh the config.
#ZZ_BROWSER_FPS=60

# ── Diagnostics ───────────────────────────────────────────────────────
# Log directory override. Default: XDG state dir (Linux), platform
# equivalent elsewhere.
#ZZ_LOG_DIR=/tmp/zz-logs

# Standard env_logger filter (zz uses Env::default()).
#RUST_LOG=zz_browser::accelerated_paint=trace

# ── scripts/remote-attach-m0.sh only ──────────────────────────────────
# zz binary to run locally. Default: target/debug/zz.
#ZZ_BIN=target/debug/zz

# Local endpoint the ssh forward binds. Default: /tmp/zz-remote.sock.
#ZZ_LOCAL_SOCKET=/tmp/zz-remote.sock

# measure_attach example binary (local; remote build for the opt-in
# same-revision direct baseline). Defaults: target/debug/examples/measure_attach.
#ZZ_MEASURE_BIN=target/debug/examples/measure_attach
#ZZ_REMOTE_MEASURE_BIN=

# Measurement sample count. Default: 25.
#ZZ_MEASURE_SAMPLES=25

# 1 = headless: measure through the forward but skip opening the GUI.
#ZZ_MEASURE_ONLY=1
