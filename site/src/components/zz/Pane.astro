---
// pane_surface (zz-ui/src/pane.rs:52) with pane-gaps ON: squircle corners,
// a 1px theme.border ring, and a 6px gutter owned by the canvas. The stock config
// has pane-gaps false (config/mod.rs:53) — pass `flush` for that look.
interface Props {
	flush?: boolean;
	/** Pane content plane. Terminals paint their own; surface panes use theme.background. */
	background?: string;
	/** Surface-style panes take a flat scrim when unfocused (INACTIVE_PANE_FADE = 0.3). */
	inactive?: boolean;
	/** Stable id, so the sidebar and the canvas can address the same pane. */
	id?: string;
	/** The attached pane. Ring = foreground.alpha(0.2), 1px (styled.rs:76-78). */
	focused?: boolean;
	class?: string;
}

const { flush = false, background, inactive = false, id, focused, class: cls } = Astro.props;
---

<div
	class:list={['pane', flush && 'pane--flush', inactive && 'pane--inactive', cls]}
	style={background ? `--pane-bg:${background}` : undefined}
	data-pane={id}
	data-focused={focused ? '' : undefined}
>
	<slot />
	{inactive && <span class="scrim" aria-hidden="true" />}
</div>

<style>
	.pane {
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background: var(--pane-bg, var(--zz-bg));
		border: var(--zz-pane-border) solid var(--zz-border);
		border-radius: var(--zz-radius-pane);
		corner-shape: squircle;
	}
	.pane[data-focused] {
		border-color: var(--zz-focus-soft);
	}
	/* pane-gaps false: no margin, no border, no radius — a 1px hairline divides
	   neighbours and only window-edge corners round (config/mod.rs:744). */
	.pane--flush {
		border: 0;
		border-radius: 0;
	}
	.scrim {
		position: absolute;
		inset: 0;
		background: rgba(10, 10, 10, 0.3);
		pointer-events: none;
	}
</style>
