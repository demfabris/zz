 /// Horizontal tab moves the cursor to the next tabstop, clearing
 /// the screen to the left the tabstop.
 pub fn horizontalTab(self: *Terminal) void {
-    while (self.screens.active.cursor.x < self.scrolling_region.right) {
-        // Move the cursor right
-        self.screens.active.cursorRight(1);
-
-        // If the last cursor position was a tabstop we return. We do
-        // "last cursor position" because we want a space to be written
-        // at the tabstop unless we're at the end (the while condition).
-        if (self.tabstops.get(self.screens.active.cursor.x)) return;
+    const screen = self.screens.active;
+    const start = screen.cursor.x;
+    const y = screen.cursor.y;
+    while (screen.cursor.x < self.scrolling_region.right) {
+        screen.cursorRight(1);
+        if (self.tabstops.get(screen.cursor.x)) break;
+    }
+    const width = screen.cursor.x - start;
+    if (width == 0 or width > 32) return;
+    const first = screen.pages.getCell(.{ .active = .{ .x = start, .y = y } }).?;
+    const first_cell = first.cell.*;
+    var x = start;
+    while (x < start + width) : (x += 1) {
+        const cell = screen.pages.getCell(.{ .active = .{ .x = x, .y = y } }).?.cell.*;
+        if (cell.wide != .narrow or cell.hyperlink or cell.tab != 0) return;
+        if (cell.codepoint() != 0 and cell.codepoint() != ' ') return;
+        if (cell.style_id != first_cell.style_id or cell.content_tag != first_cell.content_tag or cell.bg_indexed != first_cell.bg_indexed) return;
+        if (cell.content_tag == .bg_color_palette and cell.content.color_palette.data != first_cell.content.color_palette.data) return;
+        if (cell.content_tag == .bg_color_rgb and cell.content.color_rgb != first_cell.content.color_rgb) return;
+    }
+    x = start;
+    while (x < start + width) : (x += 1) {
+        const rac = screen.pages.getCell(.{ .active = .{ .x = x, .y = y } }).?;
+        rac.cell.tab = if (x == start) @intCast(width) else 128 + @as(u8, @intCast(x - start));
+        rac.row.dirty = true;
     }
 }
 
