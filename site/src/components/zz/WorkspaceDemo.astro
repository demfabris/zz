	/* ── scenes and splits ──────────────────────────────────────────────────
	   One scene per window; only the attached one is in the layout. A split is
	   two children plus a 6px slot — the slot is the pane margin, and the split
	   slot is max(margin, 1) (pane.rs:231). --frac is the first child's share of
	   what is left after the slot, so it matches the app's ratio exactly.
	   Defaults measured off the capture: 48.5/51.5 across, 50.2/49.8 down. */
	#canvas { height: 100%; }
	.scene { position: relative; height: 100%; }
	.scene > :global([data-pane]) { width: 100%; height: 100%; }
	.scene[hidden] { display: none; }

	/* --slot has to be substituted here rather than inherited from a token: a
	   custom property resolves its var()s where it is declared, and --zz-pane-margin
	   is a live knob set further up the tree. Everything below reads --slot, so
	   the split, its handle and the drag maths can never disagree. */
	.split {
		--slot: max(var(--zz-pane-margin), 1px);
		position: relative;
		display: grid;
		gap: var(--slot);
		min-width: 0;
		min-height: 0;
		height: 100%;
		/* The slot shows the split's own background: the gap plane while gaps are
		   on (already the window colour), the border hairline when they are off
		   (pane.rs:306-326). */
		background: var(--zz-split-ink, transparent);
	}
	.split[data-axis='x'] {
		grid-template-columns: calc((100% - var(--slot)) * var(--frac)) minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr);
	}
	.split[data-axis='y'] {
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: calc((100% - var(--slot)) * var(--frac)) minmax(0, 1fr);
	}

	/* 16px thick, centred on the slot (pane.rs:237-267) — so a thinner slot widens
	   the overhang rather than shrinking the hit target. */
	.split-handle {
		position: absolute;
		z-index: 2;
		touch-action: none;
	}
	.split[data-axis='x'] > .split-handle {
		top: 0;
		bottom: 0;
		left: calc((100% - var(--slot)) * var(--frac) - (16px - var(--slot)) / 2);
		width: 16px;
		cursor: col-resize;
	}
	.split[data-axis='y'] > .split-handle {
