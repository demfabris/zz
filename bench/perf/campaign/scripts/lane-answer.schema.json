{
  "type": "object",
  "additionalProperties": false,
  "required": ["done", "head", "commits", "gates", "deviations", "open"],
  "properties": {
    "done": {"type": "boolean", "description": "true only when the brief's done criterion holds"},
    "head": {"type": "string", "description": "worktree HEAD sha at the end"},
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "subject"],
        "properties": {"sha": {"type": "string"}, "subject": {"type": "string"}}
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "exit", "skipped", "result"],
        "properties": {
          "cmd": {"type": "string"},
          "exit": {"type": ["integer", "null"]},
          "skipped": {"type": "boolean"},
          "result": {"type": "string", "description": "numbers or pass/fail counts, one line"}
        }
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}},
    "open": {"type": "array", "items": {"type": "string"}}
  }
}
